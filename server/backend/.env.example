# Cấu hình cho server/backend (Node/Express + SQLite) — copy thành `.env` trong
# thư mục server/backend/ rồi chỉnh giá trị thật.

PORT=3001

# Mật khẩu đăng nhập trang quản lý (đăng ký khuôn mặt + xem log). PoC nên chỉ
# có 1 tài khoản admin, không cần bảng user/role phức tạp.
ADMIN_PASSWORD=change-me-admin-password

# Phải khớp với EDGE_DEVICE_KEY trong edge/.env (Pi) — mọi request từ
# thiết bị biên (POST /api/access-events, GET /api/face-data, /api/last-state)
# phải kèm header X-Device-Key đúng giá trị này.
EDGE_DEVICE_KEY=change-me-edge-key-demo

# AI Service rút gọn (server/ai) chạy trên cùng laptop, port riêng —
# dùng khi đăng ký khuôn mặt qua trang quản lý (POST /api/users/:code/face).
AI_SERVICE_URL=http://localhost:8001

# Đường dẫn file SQLite (mặc định server/backend/data/attendance.db nếu để trống)
DB_PATH=
