{
  "name": "aiot-lab-access-server",
  "version": "1.0.0",
  "description": "Server toi gian cho PoC diem danh ra/vao phong lab bang khuon mat (SQLite, khong pgvector, khong session/course).",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test --test-timeout=45000 ../../tools/test_event_ui.mjs ../../tools/test_event_backend_migration.mjs ../../tools/test_software_integration.mjs ../../tools/test_fixture_lifecycle.mjs ../../tools/test_release_contracts.mjs ../../tools/test_operational_tools.mjs ../../tools/test_autonomous_integration.mjs ../../tools/test_legacy_auth.mjs ../../tools/test_admin_auth.mjs ../../tools/test_cpu_preparation.mjs ../../tools/test_one_image_enrollment.mjs ../../tools/test_lab_attendance.mjs",
    "test:aiot": "node --test --test-timeout=45000 ../../tools/test_event_ui.mjs ../../tools/test_event_backend_migration.mjs ../../tools/test_software_integration.mjs ../../tools/test_fixture_lifecycle.mjs ../../tools/test_release_contracts.mjs ../../tools/test_operational_tools.mjs ../../tools/test_autonomous_integration.mjs ../../tools/test_admin_auth.mjs ../../tools/test_cpu_preparation.mjs ../../tools/test_one_image_enrollment.mjs ../../tools/test_lab_attendance.mjs",
    "test:cpu": "node --test --test-concurrency=1 --test-timeout=120000 ../../tools/test_cpu_preparation.mjs ../../tools/test_one_image_enrollment.mjs",
    "test:browser": "playwright test",
    "mock": "node ../../tools/run_mock.mjs"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "multer": "2.4.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}
