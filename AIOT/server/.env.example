# Cấu hình cho AIOT/server (Node/Express + SQLite) — copy thành `.env` trong
# thư mục AIOT/server/ rồi chỉnh giá trị thật.

PORT=3001
HOST=127.0.0.1
# production or mock. Mock MUST use a separate explicit DB_PATH; use tools/run_mock.mjs.
APP_MODE=production
ADMIN_TOKEN_TTL_SECONDS=3600

# Mật khẩu đăng nhập trang quản lý (đăng ký khuôn mặt + xem log). PoC nên chỉ
# có 1 tài khoản admin, không cần bảng user/role phức tạp.
ADMIN_PASSWORD=change-me-admin-password

# Phải khớp với EDGE_DEVICE_KEY trong AIOT/.env (Orange Pi) — mọi request từ
# thiết bị biên (POST /api/access-events, GET /api/face-data, /api/last-state)
# phải kèm header X-Device-Key đúng giá trị này.
EDGE_DEVICE_KEY=change-me-edge-key-demo

# AI Service rút gọn (AIOT/server/ai) chạy trên cùng laptop, port riêng —
# dùng khi đăng ký khuôn mặt qua trang quản lý (POST /api/users/:code/face).
AI_SERVICE_URL=http://localhost:8001

# Đường dẫn file SQLite (mặc định AIOT/server/data/attendance.db nếu để trống)
DB_PATH=
WORKER_BASE_URL=http://127.0.0.1:5000
