# Cấu hình cho tiến trình EDGE (Orange Pi PC) — copy thành `.env` (cùng cấp,
# trong thư mục AIOT/) rồi chỉnh lại giá trị thật trước khi chạy
# scripts/run_edge.sh hoặc systemd service.
# File này KHÔNG dùng cho AIOT/server trên laptop — server có .env riêng,
# xem AIOT/server/.env.example.

# --- Camera ---
# Không hard-code chắc chắn /dev/video0 — nếu node này không mở được, edge sẽ
# tự thử lần lượt /dev/video0, /dev/video1, /dev/video2 (xem edge/camera.py).
CAMERA_DEVICE=/dev/video1
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=10
CAMERA_FOURCC=MJPG

# --- Xử lý AI ---
PROCESS_EVERY_N_FRAMES=3
DETECT_WIDTH=320
DETECTION_SCORE_THRESHOLD=0.80

# "cv2dnn" (khuyến nghị, thử trước): dùng nguyên model w600k_mbf.onnx qua module
#   cv2.dnn — không cần onnxruntime (không có wheel/gói apt cho ARMv7).
# "remote" (fallback nếu cv2.dnn không import được model trên Orange Pi thật):
#   gửi ảnh mặt đã align sang AI Service trên laptop (AI_SERVICE_URL) để lấy embedding.
EMBEDDING_BACKEND=cv2dnn

# --- Stream debug (MJPEG, chỉ dùng để xem trực quan lúc demo/PoC) ---
STREAM_HOST=0.0.0.0
STREAM_PORT=5000
JPEG_QUALITY=70

# --- Kết nối tới laptop (AIOT/server) ---
# Laptop bật Internet Connection Sharing qua cổng Ethernet: 192.168.137.1
# (IP của Orange Pi có thể đổi sau khi reboot, nhưng IP laptop thường cố định).
SERVER_BASE_URL=http://192.168.137.1:3001
AI_SERVICE_URL=http://192.168.137.1:8001
DEVICE_ID=ORANGE_PI_PC_01
# Phải khớp với EDGE_DEVICE_KEY trong AIOT/server/.env trên laptop
EDGE_DEVICE_KEY=change-me-edge-key-demo

HTTP_TIMEOUT_SECONDS=3
FACE_DATA_REFRESH_SECONDS=300

# --- Nghiệp vụ ra/vào (check-in/check-out) ---
ATTENDANCE_COOLDOWN_SECONDS=60
SIMILARITY_THRESHOLD=0.60

LOG_LEVEL=INFO
