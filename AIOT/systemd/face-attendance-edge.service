[Unit]
Description=Face Attendance Edge Service (Orange Pi PC)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Đổi User= cho khớp user thực tế trên Orange Pi. User này cần thuộc group "video"
# để mở được /dev/video* (sudo usermod -aG video <user>).
User=orangepi
Group=orangepi
# 3 dòng dưới giả định đã copy nội dung AIOT/ vào đúng /opt/face-attendance-edge
# (quy ước của scripts/deploy_edge.sh). Nếu copy vào đường dẫn khác, sửa lại
# cả 3 dòng này cho khớp.
WorkingDirectory=/opt/face-attendance-edge
EnvironmentFile=/opt/face-attendance-edge/.env
ExecStart=/opt/face-attendance-edge/.venv/bin/python3 /opt/face-attendance-edge/edge/main.py

Restart=on-failure
RestartSec=5

# main.py bắt SIGTERM để giải phóng camera trước khi thoát (xem edge/main.py:_handle_signal)
KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
