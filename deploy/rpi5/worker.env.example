# Provision a private /etc/attendance/worker.env, never commit credentials.
EDGE_DEVICE_KEY=change-me-provision-random-48-hex-characters
CAMERA_BACKEND=picamera2
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=10
SERVER_BASE_URL=http://127.0.0.1:3001
AI_SERVICE_URL=http://127.0.0.1:8001
DEVICE_ID=PI5_KIOSK_01
EMBEDDING_BACKEND=cv2dnn
STREAM_HOST=127.0.0.1
STREAM_PORT=5000
EDGE_OUTBOX_PATH=/var/lib/attendance/edge-outbox.db
MEMBER_GALLERY_CACHE_PATH=/var/lib/attendance/member-gallery.json
LOG_LEVEL=INFO
