*.mo
*.pot

# Frameworks / Local configs
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.webassets-cache
.scrapy

# Documentation
docs/_build/
site/

# Build tools
.pybuilder/
target/

# Jupyter / IPython
.ipynb_checkpoints
profile_default/
ipython_config.py

