# Cấu hình cho tiến trình EDGE (Raspberry Pi) — copy thành `.env` (cùng cấp,
# trong thư mục edge/) rồi chỉnh lại giá trị thật trước khi chạy
# scripts/run_edge.sh hoặc systemd service.
# File này KHÔNG dùng cho server trên laptop — server có .env riêng,
# xem server/backend/.env.example.

# --- Camera ---
# main.py --live-test mặc định rpicam (Camera Module 3), port 8080, không attendance.
# Chế độ main.py không có --live-test vẫn dùng cấu hình USB/attendance dưới đây.
CAMERA_BACKEND=rpicam
CAMERA_INDEX=0
# Không hard-code chắc chắn /dev/video0 — nếu node này không mở được, edge sẽ
# tự thử lần lượt /dev/video0, /dev/video1, /dev/video2 (xem camera.py).
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=10
CAMERA_FOURCC=MJPG

# --- Xử lý AI ---
PROCESS_EVERY_N_FRAMES=3
DETECT_WIDTH=320
DETECTION_SCORE_THRESHOLD=0.80

# EdgeFace dùng ONNX Runtime CPU; OpenCV DNN 4.11 không hỗ trợ graph CumSum.
EMBEDDING_BACKEND=onnxruntime
RECOGNIZER_THREADS=2
# Mặc định trong config.py: model/edgeface_xs_gamma_06.onnx, profile edgeface.
# Có thể ghi đè bằng đường dẫn model tuyệt đối và RECOGNIZER_PROFILE=edgeface.

# --- Stream debug (MJPEG, chỉ dùng để xem trực quan lúc demo/PoC) ---
STREAM_HOST=0.0.0.0
STREAM_PORT=5000
JPEG_QUALITY=70

# --- Kết nối tới laptop (server) ---
# Pi và laptop cùng mạng ZeroTier — dùng IP ZeroTier của máy chạy server
# (không đổi dù Pi cắm vào mạng nào).
SERVER_BASE_URL=http://10.115.62.233:3001
AI_SERVICE_URL=http://10.115.62.233:8001
DEVICE_ID=RPI5_01
# Phải khớp với EDGE_DEVICE_KEY trong server/backend/.env trên laptop
EDGE_DEVICE_KEY=change-me-edge-key-demo

HTTP_TIMEOUT_SECONDS=3
FACE_DATA_REFRESH_SECONDS=300

# --- Nghiệp vụ ra/vào (check-in/check-out) ---
ATTENDANCE_COOLDOWN_SECONDS=60
SIMILARITY_THRESHOLD=0.60

LOG_LEVEL=INFO
