[Unit]
Description=Face Attendance Edge Service (Raspberry Pi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Đổi User= cho khớp user thực tế trên Pi. User này cần thuộc group "video"
# để mở được /dev/video* (sudo usermod -aG video <user>).
User=raspberrypi
Group=raspberrypi
# 3 dòng dưới giả định đã copy nội dung edge/ vào đúng /home/raspberrypi/face-attendance-edge
# (quy ước của scripts/deploy_edge.sh). Nếu copy vào đường dẫn khác, sửa lại
# cả 3 dòng này cho khớp.
WorkingDirectory=/home/raspberrypi/face-attendance-edge
EnvironmentFile=/home/raspberrypi/face-attendance-edge/.env
ExecStart=/home/raspberrypi/face-attendance-edge/.venv/bin/python3 /home/raspberrypi/face-attendance-edge/main.py

Restart=on-failure
RestartSec=5

# main.py bắt SIGTERM để giải phóng camera trước khi thoát (xem main.py:_handle_signal)
KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
